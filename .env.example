# All services bind to 127.0.0.1. No remote joining.
AGENT_GAME_PORT=3211
# Trusted static website origins. The release package records its website origin.
# AGENT_GAME_WEB_ORIGINS=https://your-game.example
# Optional absolute executable paths. Existing Codex sign-in is used.
# CODEX_PATH=C:\Users\you\AppData\Local\OpenAI\Codex\bin\version\codex.exe
# CODEX_ACP_PATH=C:\tools\codex-acp.exe
# Optional persistent data location; defaults to LocalAppData/AgentArcade on Windows.
# AGENT_GAME_DATA_DIR=C:\Users\you\AppData\Local\AgentArcade
